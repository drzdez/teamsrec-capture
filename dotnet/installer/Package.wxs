<?xml version="1.0" encoding="utf-8"?>
<!--
  teamsrec-capture: per-user MSI, no admin rights. Installs into %LOCALAPPDATA%\Programs\teamsrec-capture (the same
  folder as the manual install before, so an upgrade replaces it in place), a Start menu shortcut and a Startup
  shortcut (autostart at login). A newer MSI upgrades an older one.

  Before the files are replaced a running app is asked to quit (quit.request next to the exe, see App/QuitRequest.cs).
  The app refuses during a recording; the install then stops with an error and can be run again after the meeting.
  After the install the app is started again (LAUNCHAPP=0 to skip).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="teamsrec-capture"
           Manufacturer="drzdez"
           Version="$(ProductVersion)"
           UpgradeCode="6f1d2c3e-8a4b-4e57-9a0c-2b7d5e1f3a91"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/drzdez/teamsrec-capture" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="LAUNCHAPP" Value="1" />

    <!-- a plain per-user package has no per-user Program Files: %LOCALAPPDATA%\Programs explicitly -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="teamsrec-capture" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="App" Directory="INSTALLFOLDER">
      <Component Id="Exe">
        <File Id="AppExe" Source="$(PublishDir)\teamsrec-capture.exe" KeyPath="yes" />
        <!-- leftovers of the framework-dependent manual install (dlls, json, pdb) next to the single-file exe -->
        <RemoveFile Id="OldDlls" Name="*.dll" On="install" />
        <RemoveFile Id="OldJson" Name="*.json" On="install" />
        <RemoveFile Id="OldPdb" Name="*.pdb" On="install" />
        <RemoveFile Id="QuitRequest" Name="quit.request" On="both" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="StartMenu" Name="teamsrec - capture" Description="Records Teams calls and meetings"
                  Target="[INSTALLFOLDER]teamsrec-capture.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\teamsrec\capture" Name="StartMenuShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- the same name as the shortcut of the manual install, so it is replaced and not doubled -->
    <StandardDirectory Id="StartupFolder">
      <Component Id="AutostartShortcut">
        <Shortcut Id="Autostart" Name="teamsrec - capture" Target="[INSTALLFOLDER]teamsrec-capture.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\teamsrec\capture" Name="AutostartShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="App" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="AutostartShortcut" />
    </Feature>

    <!-- Ask a running app to quit and wait for it (90 s: a finishing recording writes its mix first). Runs
         whatever version is installed, also the manual install before the first MSI. No square brackets in the
         script: MSI would read them as property references. A Property, not SetProperty: a custom action's
         target is limited to 255 characters, a property value is not; WixQuietExec formats it at run time. -->
    <Property Id="WixQuietExecCmdLine" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$d = '[INSTALLFOLDER]'; $exe = Join-Path $d 'teamsrec-capture.exe'; $req = Join-Path $d 'quit.request'; function running { @(Get-Process teamsrec-capture -ErrorAction SilentlyContinue | Where-Object { $_.Path -eq $exe }).Count -gt 0 }; if (running) { New-Item -ItemType File -Force -Path $req | Out-Null; $t = 0; while ((running) -and $t -lt 90) { Start-Sleep -Seconds 1; $t++ }; Remove-Item -Force -ErrorAction SilentlyContinue -Path $req; if (running) { exit 1 } }; exit 0&quot;" />
    <CustomAction Id="QuitRunningApp" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="immediate"
                  Return="check" />

    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]teamsrec-capture.exe&quot;"
                  Return="asyncNoWait" Impersonate="yes" />

    <InstallExecuteSequence>
      <Custom Action="QuitRunningApp" Before="InstallValidate" />
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT REMOVE AND LAUNCHAPP = 1" />
    </InstallExecuteSequence>

    <!-- shown when QuitRunningApp fails (exit 1): the app is recording or did not quit -->
    <UI>
      <Error Id="1722" Message="teamsrec-capture is recording or did not quit. Run the installer again after the recording (or Quit it from the tray icon)." />
    </UI>

  </Package>
</Wix>
